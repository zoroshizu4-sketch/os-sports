rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'zoroshizu4@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidVenueSettings(data) {
      return data.keys().hasAll(['openHour', 'closeHour', 'nightStartHour', 'currency', 'updatedAt'])
        && data.keys().hasOnly([
          'openHour', 'closeHour', 'nightStartHour',
          'dayRatePerHour', 'nightRatePerHour',
          'currency', 'customFacilities', 'announcement', 'updatedAt'
        ])
        && data.openHour is int && data.openHour >= 0 && data.openHour <= 23
        && data.closeHour is int && data.closeHour >= 1 && data.closeHour <= 24
        && data.closeHour > data.openHour
        && data.nightStartHour is int && data.nightStartHour >= 0 && data.nightStartHour <= 23
        && (!('dayRatePerHour' in data) || data.dayRatePerHour == null || (data.dayRatePerHour is number && data.dayRatePerHour >= 0 && data.dayRatePerHour <= 100000))
        && (!('nightRatePerHour' in data) || data.nightRatePerHour == null || (data.nightRatePerHour is number && data.nightRatePerHour >= 0 && data.nightRatePerHour <= 100000))
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8
        && (!('customFacilities' in data) || (data.customFacilities is list && data.customFacilities.size() <= 12 && (data.customFacilities.size() == 0 || (data.customFacilities[0] is string && data.customFacilities[0].size() <= 80))))
        && (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 240))
        && data.updatedAt is timestamp;
    }

    function isValidSlotLock(data) {
      return data.keys().hasAll(['date', 'hour', 'status', 'bookingId', 'createdAt'])
        && data.keys().hasOnly(['date', 'hour', 'status', 'bookingId', 'createdAt'])
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hour is int && data.hour >= 0 && data.hour <= 23
        && data.status in ['booked', 'blocked']
        && data.bookingId is string && data.bookingId.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'bookingRef', 'date', 'startHour', 'durationHours',
          'customerName', 'customerPhone', 'notes', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingRef', 'date', 'startHour', 'durationHours',
          'customerName', 'customerPhone', 'notes', 'status',
          'quotedTotal', 'createdAt', 'updatedAt'
        ])
        && data.bookingRef is string && data.bookingRef.size() >= 6 && data.bookingRef.size() <= 32
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startHour is int && data.startHour >= 0 && data.startHour <= 23
        && data.durationHours is int && data.durationHours >= 1 && data.durationHours <= 4
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80
        && data.customerPhone is string && data.customerPhone.size() >= 10 && data.customerPhone.size() <= 20
        && data.notes is string && data.notes.size() <= 300
        && data.status in ['pending', 'confirmed', 'cancelled']
        && (!('quotedTotal' in data) || data.quotedTotal == null || (data.quotedTotal is number && data.quotedTotal >= 0 && data.quotedTotal <= 500000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /settings/{docId} {
      allow get: if docId == 'venue';
      allow list: if false;
      allow create, update: if docId == 'venue'
        && isAdmin()
        && isValidVenueSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /slotLocks/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if true;
      allow create: if isValidId(slotId)
        && isValidSlotLock(incoming())
        && slotId == (incoming().date + '_' + string(incoming().hour))
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (
            incoming().status == 'booked'
            && incoming().bookingId.size() >= 6
            && existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId))
          )
        );
      allow update: if isAdmin()
        && isValidId(slotId)
        && isValidSlotLock(incoming())
        && incoming().date == existing().date
        && incoming().hour == existing().hour
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(slotId);
    }

    match /bookings/{bookingId} {
      allow get: if isAdmin() && isValidId(bookingId);
      allow list: if isAdmin();
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().status == 'pending'
            && existsAfter(/databases/$(database)/documents/slotLocks/$(incoming().date + '_' + string(incoming().startHour)))
          )
        );
      allow update: if isAdmin()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().bookingRef == existing().bookingRef
        && incoming().date == existing().date
        && incoming().startHour == existing().startHour
        && incoming().durationHours == existing().durationHours
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'quotedTotal', 'notes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isAdmin();
      allow list, create, update, delete: if false;
    }
  }
}
